[
 {
  "doctype": "Custom Field",
  "name": "Project-ataa_donation_tab",
  "dt": "Project",
  "module": "Ataa Hub",
  "insert_after": "cost_center",
  "fieldname": "ataa_donation_tab",
  "fieldtype": "Tab Break",
  "label": "Donations"
 },
 {
  "doctype": "Custom Field",
  "name": "Project-project_code",
  "dt": "Project",
  "module": "Ataa Hub",
  "insert_after": "ataa_donation_tab",
  "fieldname": "project_code",
  "fieldtype": "Data",
  "label": "Project Code",
  "unique": 1,
  "in_standard_filter": 1,
  "no_copy": 1,
  "description": "Stable code used by the donation API, e.g. SUQYA-01"
 },
 {
  "doctype": "Custom Field",
  "name": "Project-fund_type",
  "dt": "Project",
  "module": "Ataa Hub",
  "insert_after": "project_code",
  "fieldname": "fund_type",
  "fieldtype": "Select",
  "label": "Fund Type",
  "options": "\nRestricted\nUnrestricted",
  "in_standard_filter": 1,
  "in_list_view": 1,
  "description": "Restricted money can only be spent on this project"
 },
 {
  "doctype": "Custom Field",
  "name": "Project-is_public",
  "dt": "Project",
  "module": "Ataa Hub",
  "insert_after": "fund_type",
  "fieldname": "is_public",
  "fieldtype": "Check",
  "label": "Show on Donation Page and API"
 },
 {
  "doctype": "Custom Field",
  "name": "Project-ataa_col_1",
  "dt": "Project",
  "module": "Ataa Hub",
  "insert_after": "is_public",
  "fieldname": "ataa_col_1",
  "fieldtype": "Column Break",
  "label": null
 },
 {
  "doctype": "Custom Field",
  "name": "Project-target_amount",
  "dt": "Project",
  "module": "Ataa Hub",
  "insert_after": "ataa_col_1",
  "fieldname": "target_amount",
  "fieldtype": "Currency",
  "label": "Target Amount",
  "depends_on": "eval:doc.fund_type=='Restricted'",
  "mandatory_depends_on": "eval:doc.fund_type=='Restricted'"
 },
 {
  "doctype": "Custom Field",
  "name": "Project-allow_custom_amount",
  "dt": "Project",
  "module": "Ataa Hub",
  "insert_after": "target_amount",
  "fieldname": "allow_custom_amount",
  "fieldtype": "Check",
  "label": "Allow Custom Amount",
  "default": "1"
 },
 {
  "doctype": "Custom Field",
  "name": "Project-ataa_public_section",
  "dt": "Project",
  "module": "Ataa Hub",
  "insert_after": "allow_custom_amount",
  "fieldname": "ataa_public_section",
  "fieldtype": "Section Break",
  "label": "Public Page",
  "depends_on": "is_public"
 },
 {
  "doctype": "Custom Field",
  "name": "Project-public_title",
  "dt": "Project",
  "module": "Ataa Hub",
  "insert_after": "ataa_public_section",
  "fieldname": "public_title",
  "fieldtype": "Data",
  "label": "Public Title",
  "translatable": 0
 },
 {
  "doctype": "Custom Field",
  "name": "Project-public_description",
  "dt": "Project",
  "module": "Ataa Hub",
  "insert_after": "public_title",
  "fieldname": "public_description",
  "fieldtype": "Small Text",
  "label": "Public Description"
 },
 {
  "doctype": "Custom Field",
  "name": "Project-ataa_col_2",
  "dt": "Project",
  "module": "Ataa Hub",
  "insert_after": "public_description",
  "fieldname": "ataa_col_2",
  "fieldtype": "Column Break",
  "label": null
 },
 {
  "doctype": "Custom Field",
  "name": "Project-public_image",
  "dt": "Project",
  "module": "Ataa Hub",
  "insert_after": "ataa_col_2",
  "fieldname": "public_image",
  "fieldtype": "Attach Image",
  "label": "Public Image"
 },
 {
  "doctype": "Custom Field",
  "name": "Project-ataa_impact_section",
  "dt": "Project",
  "module": "Ataa Hub",
  "insert_after": "public_image",
  "fieldname": "ataa_impact_section",
  "fieldtype": "Section Break",
  "label": "Impact"
 },
 {
  "doctype": "Custom Field",
  "name": "Project-impact_unit_label",
  "dt": "Project",
  "module": "Ataa Hub",
  "insert_after": "ataa_impact_section",
  "fieldname": "impact_unit_label",
  "fieldtype": "Data",
  "label": "Impact Unit Label",
  "description": "What one unit means, e.g. معتمر سُقي"
 },
 {
  "doctype": "Custom Field",
  "name": "Project-ataa_col_3",
  "dt": "Project",
  "module": "Ataa Hub",
  "insert_after": "impact_unit_label",
  "fieldname": "ataa_col_3",
  "fieldtype": "Column Break",
  "label": null
 },
 {
  "doctype": "Custom Field",
  "name": "Project-impact_units_per_sar",
  "dt": "Project",
  "module": "Ataa Hub",
  "insert_after": "ataa_col_3",
  "fieldname": "impact_units_per_sar",
  "fieldtype": "Float",
  "label": "Impact Units per SAR",
  "non_negative": 1
 },
 {
  "doctype": "Custom Field",
  "name": "Project-ataa_options_section",
  "dt": "Project",
  "module": "Ataa Hub",
  "insert_after": "impact_units_per_sar",
  "fieldname": "ataa_options_section",
  "fieldtype": "Section Break",
  "label": "Donation Options"
 },
 {
  "doctype": "Custom Field",
  "name": "Project-donation_options",
  "dt": "Project",
  "module": "Ataa Hub",
  "insert_after": "ataa_options_section",
  "fieldname": "donation_options",
  "fieldtype": "Table",
  "label": "Ready Amounts",
  "options": "Project Donation Option"
 },
 {
  "doctype": "Custom Field",
  "name": "Customer-ataa_donor_tab",
  "dt": "Customer",
  "module": "Ataa Hub",
  "insert_after": "loyalty_program_tier",
  "fieldname": "ataa_donor_tab",
  "fieldtype": "Tab Break",
  "label": "Donor"
 },
 {
  "doctype": "Custom Field",
  "name": "Customer-donor_mobile",
  "dt": "Customer",
  "module": "Ataa Hub",
  "insert_after": "ataa_donor_tab",
  "fieldname": "donor_mobile",
  "fieldtype": "Data",
  "label": "Donor Mobile",
  "unique": 1,
  "in_standard_filter": 1,
  "description": "+9665XXXXXXXX, used to match returning donors"
 },
 {
  "doctype": "Custom Field",
  "name": "Customer-lifetime_giving",
  "dt": "Customer",
  "module": "Ataa Hub",
  "insert_after": "donor_mobile",
  "fieldname": "lifetime_giving",
  "fieldtype": "Currency",
  "label": "Lifetime Giving",
  "description": "Recomputed from submitted donations and paid membership invoices",
  "read_only": 1,
  "no_copy": 1
 },
 {
  "doctype": "Custom Field",
  "name": "Customer-ataa_membership_section",
  "dt": "Customer",
  "module": "Ataa Hub",
  "insert_after": "lifetime_giving",
  "fieldname": "ataa_membership_section",
  "fieldtype": "Section Break",
  "label": "Membership"
 },
 {
  "doctype": "Custom Field",
  "name": "Customer-membership_tier",
  "dt": "Customer",
  "module": "Ataa Hub",
  "insert_after": "ataa_membership_section",
  "fieldname": "membership_tier",
  "fieldtype": "Select",
  "label": "Membership Tier",
  "options": "\nMuazir\nMusanid\nAoun\nAdeed\nKareem\nDaem\nHonorary",
  "in_standard_filter": 1,
  "read_only": 1,
  "no_copy": 1
 },
 {
  "doctype": "Custom Field",
  "name": "Customer-membership_number",
  "dt": "Customer",
  "module": "Ataa Hub",
  "insert_after": "membership_tier",
  "fieldname": "membership_number",
  "fieldtype": "Data",
  "label": "Membership Number",
  "unique": 1,
  "read_only": 1,
  "no_copy": 1,
  "search_index": 1
 },
 {
  "doctype": "Custom Field",
  "name": "Customer-membership_status",
  "dt": "Customer",
  "module": "Ataa Hub",
  "insert_after": "membership_tier",
  "fieldname": "membership_status",
  "fieldtype": "Select",
  "label": "Membership Status",
  "options": "\nActive\nPayment Pending\nSuspended\nCancelled",
  "in_standard_filter": 1,
  "read_only": 1,
  "no_copy": 1
 },
 {
  "doctype": "Custom Field",
  "name": "Customer-membership_subscription",
  "dt": "Customer",
  "module": "Ataa Hub",
  "insert_after": "membership_status",
  "fieldname": "membership_subscription",
  "fieldtype": "Link",
  "label": "Membership Subscription",
  "options": "Subscription",
  "read_only": 1,
  "no_copy": 1
 },
 {
  "doctype": "Custom Field",
  "name": "Customer-ataa_col_4",
  "dt": "Customer",
  "module": "Ataa Hub",
  "insert_after": "membership_subscription",
  "fieldname": "ataa_col_4",
  "fieldtype": "Column Break",
  "label": null
 },
 {
  "doctype": "Custom Field",
  "name": "Customer-member_since",
  "dt": "Customer",
  "module": "Ataa Hub",
  "insert_after": "ataa_col_4",
  "fieldname": "member_since",
  "fieldtype": "Date",
  "label": "Member Since",
  "read_only": 1,
  "no_copy": 1
 },
 {
  "doctype": "Custom Field",
  "name": "Customer-honorary_since",
  "dt": "Customer",
  "module": "Ataa Hub",
  "insert_after": "member_since",
  "fieldname": "honorary_since",
  "fieldtype": "Date",
  "label": "Honorary Since",
  "read_only": 1,
  "no_copy": 1
 },
 {
  "doctype": "Custom Field",
  "name": "Sales Invoice-is_membership",
  "dt": "Sales Invoice",
  "module": "Ataa Hub",
  "insert_after": "is_debit_note",
  "fieldname": "is_membership",
  "fieldtype": "Check",
  "label": "Membership",
  "in_standard_filter": 1,
  "read_only": 1,
  "no_copy": 1
 },
 {
  "doctype": "Custom Field",
  "name": "Payment Entry-is_membership",
  "dt": "Payment Entry",
  "module": "Ataa Hub",
  "insert_after": "mode_of_payment",
  "fieldname": "is_membership",
  "fieldtype": "Check",
  "label": "Membership",
  "in_standard_filter": 1,
  "read_only": 1,
  "no_copy": 1
 },
 {
  "doctype": "Custom Field",
  "name": "Journal Entry-ataa_reference_doctype",
  "dt": "Journal Entry",
  "module": "Ataa Hub",
  "insert_after": "user_remark",
  "fieldname": "ataa_reference_doctype",
  "fieldtype": "Link",
  "label": "Created From (Type)",
  "options": "DocType",
  "read_only": 1,
  "no_copy": 1
 },
 {
  "doctype": "Custom Field",
  "name": "Journal Entry-ataa_reference_name",
  "dt": "Journal Entry",
  "module": "Ataa Hub",
  "insert_after": "ataa_reference_doctype",
  "fieldname": "ataa_reference_name",
  "fieldtype": "Dynamic Link",
  "label": "Created From",
  "options": "ataa_reference_doctype",
  "read_only": 1,
  "no_copy": 1
 }
]
