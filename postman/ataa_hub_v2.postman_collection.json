      "key": "store_donation_id",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// paid_at = one minute ago, ISO 8601 with Riyadh offset",
          "const d = new Date(Date.now() + 3 * 3600 * 1000 - 60 * 1000);",
          "pm.collectionVariables.set('paid_at', d.toISOString().slice(0, 19) + '+03:00');"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Discovery",
      "item": [
        {
          "name": "List projects",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "token {{store_api_key}}:{{store_api_secret}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/method/ataa_hub.api.v1.list_projects"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"SUQYA-01 has v2 fields\", () => {",
                  "  const p = body.message.data.find(x => x.project_code === \"SUQYA-01\");",
                  "  pm.expect(p).to.include.keys(\"fund_type\", \"impact_unit_label\", \"impact_units_per_sar\", \"collected_amount\");",
                  "});",
                  "pm.test(\"closed project not listed\", () => pm.expect(body.message.data.map(x => x.project_code)).to.not.include(\"WINTER-06\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "List projects for event",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "token {{store_api_key}}:{{store_api_secret}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/method/ataa_hub.api.v1.list_projects?event_code=CLOCKTOWER-2026"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"only event projects\", () => pm.expect(body.message.data.map(x => x.project_code).sort()).to.eql([\"SUQYA-01\", \"WAFADA-02\"]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Online store",
      "item": [
        {
          "name": "Create donation (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "token {{store_api_key}}:{{store_api_secret}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/method/ataa_hub.api.v1.create_donation",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_reference\": \"{{ref}}\",\n  \"project_code\": \"SUQYA-01\",\n  \"amount\": 250,\n  \"paid_at\": \"{{paid_at}}\",\n  \"payment_reference\": \"pay-{{$randomUUID}}\",\n  \"donor\": {\n    \"name\": \"Test Donor\",\n    \"mobile\": \"+966500000001\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('ref', 'PM-' + Date.now() + '-' + Math.floor(Math.random() * 1e6));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"posted, not duplicate\", () => { pm.expect(body.message.data.status).to.eql(\"Paid\"); pm.expect(body.message.data.duplicate).to.eql(false); });",
                  "pm.test(\"impact and receipt link\", () => { pm.expect(body.message.data.impact_units).to.eql(250); pm.expect(body.message.data.receipt_verification_url).to.include(\"/verify/\"); });",
                  "pm.collectionVariables.set('store_ref', body.message.data.external_reference);",
                  "pm.collectionVariables.set('store_donation_id', body.message.data.donation_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry same donation (200, duplicate)",
          "request": {
