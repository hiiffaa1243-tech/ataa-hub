{
  "info": {
    "_postman_id": "6f1c2b8e-1a7d-4d2a-9c11-0a7a7a7a2026",
    "name": "Ataa Hub API v1",
    "description": "Simulates an online store and a POS terminal sending donations to Ataa Hub.\nImport `ataa_hub_local.postman_environment.json`, run `bench ... execute ataa_hub.setup.demo.seed`, then Run collection. Every request has tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "paid_at",
      "value": ""
    },
    {
      "key": "order_ref",
      "value": ""
    },
    {
      "key": "txn_ref",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// paid_at = now, ISO 8601 with Riyadh offset",
          "const d = new Date(Date.now() + 3 * 3600 * 1000);",
          "pm.collectionVariables.set('paid_at', d.toISOString().slice(0, 19) + '+03:00');"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Online store",
      "item": [
        {
          "name": "List active projects",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "token {{store_api_key}}:{{store_api_secret}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/method/ataa_hub.api.v1.list_projects",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "method",
                "ataa_hub.api.v1.list_projects"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().message.data;",
                  "pm.test('returns active projects', () => pm.expect(data.length).to.be.above(0));",
                  "pm.test('closed project hidden', () => pm.expect(data.map(p => p.project_code)).to.not.include('WINTER-06'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create donation (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "token {{store_api_key}}:{{store_api_secret}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/method/ataa_hub.api.v1.create_donation",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "method",
                "ataa_hub.api.v1.create_donation"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_reference\": \"{{order_ref}}\",\n  \"project_code\": \"SUQYA-01\",\n  \"amount\": 250.0,\n  \"paid_at\": \"{{paid_at}}\",\n  \"payment_reference\": \"pay_8f2c1a9b\",\n  \"donor\": {\n    \"name\": \"Test Donor\",\n    \"mobile\": \"+966500000001\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('order_ref', 'ORDER-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().message.data;",
                  "pm.test('not a duplicate', () => pm.expect(d.duplicate).to.eql(false));",
                  "pm.test('status Paid', () => pm.expect(d.status).to.eql('Paid'));"
                ]
              }
            }
          ]
        },
