              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
                  "pm.test('error code DONATION_NOT_FOUND', () => pm.expect(pm.response.json().message.error.code).to.eql('DONATION_NOT_FOUND'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
